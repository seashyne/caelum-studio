{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caelum Studio",
  "version": "0.2.0",
  "identifier": "com.seashyne.caelum-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Caelum Studio — Local AI Workbench",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#060608",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; frame-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
